{
  "name": "quizz-in",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local multiplayer trivia game for the living room (TV + phones on the same Wi-Fi).",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "bots": "tsx scripts/bots.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.3",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
